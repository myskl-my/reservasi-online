{
  "name": "reservasi-online",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node node_modules/next/dist/bin/next build",
    "dev": "node scripts/db-migrate.mjs && node node_modules/next/dist/bin/next dev",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "admin:pin": "node scripts/set-admin-pin.mjs",
    "admin:status": "node scripts/admin-status.mjs",
    "setup": "node scripts/setup-admin.mjs",
    "reset:admin": "node scripts/reset-admin.mjs",
    "reset:pin": "node scripts/reset-admin-pin.mjs",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/unit/*.test.mjs",
    "test:integration": "node scripts/integration-test.mjs",
    "cf:build": "node node_modules/@opennextjs/cloudflare/dist/cli/index.js build",
    "cf:pages": "node scripts/build-pages.mjs",
    "cf:deploy": "node node_modules/wrangler/bin/wrangler.js pages deploy pages-output --project-name reservasionline --branch main --commit-dirty=true",
    "cf:dev": "node node_modules/wrangler/bin/wrangler.js dev",
    "cf:migrate": "node node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --remote",
    "preview": "node node_modules/@opennextjs/cloudflare/dist/cli/index.js build && node node_modules/@opennextjs/cloudflare/dist/cli/index.js preview",
    "deploy": "npm run cf:build && npm run cf:pages && npm run cf:deploy",
    "upload": "npm run cf:build && npm run cf:pages",
    "cf-typegen": "node node_modules/wrangler/bin/wrangler.js types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@opennextjs/cloudflare": "^1.20.15",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "wrangler": "^4.156.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261102.1": true
  }
}
