# Token sekali pakai untuk membuat admin pertama lewat /setup.
# Buat nilai acak yang kuat, misalnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SETUP_TOKEN=replace-with-a-long-random-token

# Opsional: lokasi file SQLite lokal (default: data/cutqueue.db)
# CUTQUEUE_DB_PATH=C:/path/ke/cutqueue.db
